# Modelo de variáveis de ambiente da NIO-CLI v2.
# Copie para `.env` (que é git-ignored) e preencha com os valores reais.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# Conexão com o Postgres dedicado (obrigatória).
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/nio_cli
NIO_DATABASE_URL=postgres://user:senha@localhost:5432/nio_cli

# TLS — descomente e ponha "true" só se o banco exigir (gerenciado/nuvem).
# NIO_DATABASE_SSL=true
