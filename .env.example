# Database connection string
# CLI/MCP: role `nio_cli` (migration 0008) — SELECT em user_cli/auth_sessions,
# escreve só em sessions/dependency_events/log_session/session_activity.
NIO_DATABASE_URL=postgres://nio_cli_user:senha@localhost:5432/nio_cli

# Gateway: role `nio_gateway` — escreve em user_cli/auth_sessions/login_challenges/
# auth_events/login_ip_events. Só o processo nio-gateway lê esta var; se ausente,
# ele cai em NIO_DATABASE_URL (dev com um único role).
# NIO_GATEWAY_DATABASE_URL=postgres://nio_gw_user:senha@localhost:5432/nio_cli

# TLS — descomente e ponha "true" quando o banco tiver TLS (não use com Postgres
# local sem SSL). Quando ligado, o certificado do servidor É VERIFICADO.
# NIO_DATABASE_SSL=true
# NIO_DATABASE_CA=/etc/ssl/nio/db-ca.pem
# Último recurso — desliga a verificação de cert (expõe a MITM). Prefira NIO_DATABASE_CA:
# NIO_DATABASE_SSL_INSECURE=1

# Gateway — JWT (login v2). Sem prefixo NIO_ de propósito: segredo da equipe,
# mesmo valor em toda máquina que roda o nio-gateway.
# Mínimo 32 caracteres aleatórios. Gere com: `nio config setup` ou
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# JWT_EXPIRES_IN=12h

# ── Endurecimento de cripto (ADR 0011) — tudo opcional, defaults = comportamento atual ──
#
# Pepper de senha: segredo de servidor combinado à senha antes do argon2. Um dump
# do banco SEM ele não dá pra brute-forçar offline. MESMO valor em todo nó do
# gateway. PERDER = reset de senha forçado dos usuários peppered — FAÇA BACKUP.
# Formato: id:segredo[,id:segredo] — o de maior id é o atual (rotação: adiciona o
# novo, o re-hash on login migra, depois remove o velho). Gere: openssl rand -base64 32
# NIO_PEPPERS=1:troque-por-um-segredo-forte-de-32-ou-mais-chars
#
# Chave do HMAC do OTP — separa do JWT_SECRET. Default = JWT_SECRET.
# OTP_HMAC_SECRET=
#
# Rotação de JWT sem derrubar sessão: JWT_SECRETS = kid:segredo[,kid:segredo].
# A ÚLTIMA entrada assina os tokens novos; QUALQUER uma verifica. Token antigo
# (sem kid) verifica contra JWT_SECRET. Fluxo: adiciona o kid novo no fim →
# deploy → espera 12h (TTL do JWT) → remove o kid velho. Ausente = usa JWT_SECRET.
# JWT_SECRETS=2026a:segredo-antigo-de-32+-chars,2026b:segredo-novo-de-32+-chars
#
# Params do argon2id — defaults = piso OWASP. Calibre na máquina do gateway com
#   node scripts/argon2-calibrate.mjs        (ou `bun run argon2:calibrate`)
# mire ~250-500 ms no hash. Subir só re-hasheia no próximo login (não é breaking).
# NIO_ARGON2_MEMORY_MIB=19
# NIO_ARGON2_TIME=2
# NIO_ARGON2_PARALLELISM=1
#
# Auditoria de IP de login (ADR 0011 §F) — o gateway registra de quais IPs cada
# usuário loga (visível em `nio security status`; retenção 90 d). SÓ registro,
# não bloqueia. Ligue NIO_TRUST_PROXY=1 pra usar o X-Forwarded-For **apenas** se
# o Kong for a ÚNICA entrada do gateway (senão o IP é forjável).
# NIO_TRUST_PROXY=1

# Trilha de auth persistente (ADR 0012) — `auth_events` guarda todo evento de auth
# (login OK/falho, 2FA, mudanças de 2FA, logout). Retenção default 180 d.
# NIO_AUTH_EVENTS_RETENTION_DAYS=180
# No modo HOST (sem container), o stdout/stderr do gateway — incl. a trilha —
# vai pra ~/.nio/gateway.log (chmod 600).

# Bind do nio-gateway. Default 127.0.0.1 (loopback). Ponha 0.0.0.0 quando o Kong
# roda em container e alcança o gateway via host.docker.internal.
# NIO_GATEWAY_HOST=0.0.0.0
# Onde a CLI acha o gateway. Default http://127.0.0.1:3000 (o nio-gateway direto).
# Com Kong na frente: http://127.0.0.1:8000.
# NIO_GATEWAY_URL=http://127.0.0.1:8000
# Porta do proxy Kong publicada no host pelo `dev:kong` (default 8000).
# NIO_KONG_PROXY_PORT=8010

# 2º fator (SMS OTP) — spec 0004 / ADR 0006. Sem essas 3, o login com auth_2
# responde 503 "2FA não configurado" (o login de 1 fator segue normal).
# SMS_ENDPOINT_URL=https://api.seu-provedor.com/v2/sms
# SMS_AUTH_HEADER=X-API-TOKEN: seu-token          # linha "Nome: valor"
# SMS_BODY_TEMPLATE={"to":"{to}","message":"{text}"}   # JSON com {to}/{text}/{from}
# SMS_FROM=NIO                                     # opcional, se o template usar {from}

# Client de IA (nio ai) — Headroom, proxy de compressão em container (ADR 0007).
# NIO_HEADROOM_PORT=8787                                  # porta do proxy no host
# NIO_HEADROOM_URL=http://127.0.0.1:8787/v1               # override total (o provider do OpenCode aponta pra cá)
# NIO_HEADROOM_OPENAI_TARGET=https://opencode.ai/zen/v1   # upstream OpenAI-compatível (default: OpenCode Zen)

# Debug 
# NIO_DEBUG=1      # log verboso [nio:debug] + stack trace completo nos erros
# NIO_NO_ANIM=1    # logo Matrix sempre estático (sem a animação de chuva)
