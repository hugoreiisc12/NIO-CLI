{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "!**/*.md",
      "!src/adapters/embed/local-embedder.ts",
      "!src/app/lesson-detector.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/cli/**/*.ts",
        "src/cli/**/*.tsx",
        "!src/cli/**/*.test.ts",
        "!src/cli/**/*.test.tsx"
      ],
      "javascript": {
        "formatter": {
          "quoteStyle": "double"
        }
      }
    }
  ],
  "assist": {
    "enabled": false
  }
}
