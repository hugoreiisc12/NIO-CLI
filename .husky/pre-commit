#!/bin/sh
# Bloqueia secrets no commit. Ative com: git config core.hooksPath .husky
# O gate que vale é o job `secrets` no CI — este hook é só feedback rápido.

STAGED=$(git diff --cached)
[ -z "$STAGED" ] && exit 0

FAILED=0

# 1) Atribuições de segredo nomeado (KEY=valor / KEY: valor), valor não-vazio.
NAMED='(AZURE_CLIENT_SECRET|JWT_SECRET|NIO_GATEWAY_TOKEN|DATABASE_PASSWORD|AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|OPENAI_API_KEY|OTP_HMAC_SECRET|NIO_PEPPER)'
if echo "$STAGED" | grep -E "^\+.*$NAMED[\"']?\s*[:=]\s*[\"']?[A-Za-z0-9_/+.~-]{8,}" | grep -qv '\$'; then
  echo "❌ Segredo nomeado com valor literal:"
  echo "$STAGED" | grep -E "^\+.*$NAMED[\"']?\s*[:=]\s*[\"']?[A-Za-z0-9_/+.~-]{8,}" | grep -v '\$' | head -5
  FAILED=1
fi

# 2) Token hex longo solto (>=32). Exclui digests de imagem (sha256:) — são públicos.
if echo "$STAGED" | grep -E "^\+" | grep -v 'sha256:' | grep -qE '\b[a-f0-9]{32,}\b'; then
  echo "❌ Token hexadecimal (>=32 chars) — use \${VAR} ou um placeholder:"
  echo "$STAGED" | grep -E "^\+" | grep -v 'sha256:' | grep -E '\b[a-f0-9]{32,}\b' | head -5
  FAILED=1
fi

if [ $FAILED -eq 1 ]; then
  echo ""
  echo "🔒 Commit bloqueado. Veja .github/SECURITY.md"
  echo "   Falso positivo? Justifique e use: git commit --no-verify"
  exit 1
fi

exit 0
