{
  "name": "@nio-cli/cli",
  "version": "0.3.4",
  "description": "Orquestrador de ambientes de desenvolvimento: escolhe um perfil, responde um wizard e a CLI (com auxílio de IA via MCP) materializa toolchains, linguagens, frameworks, dotfiles e IDE.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "nio": "dist/cli.js",
    "nio-cli": "dist/mcp-server.js",
    "nio-gateway": "dist/gateway/index.js",
    "nio-lang": "dist/mcp-server-lang.js"
  },
  "files": [
    "dist",
    "docker/docker-compose.yml",
    "docker/kong.yml",
    "Dockerfile.gateway",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugoreiis12-png/NIO-CLI-.git"
  },
  "homepage": "https://github.com/hugoreiis12-png/NIO-CLI-#readme",
  "bugs": {
    "url": "https://github.com/hugoreiis12-png/NIO-CLI-/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "developer-environment",
    "dev-environment",
    "environment-orchestration",
    "opencode",
    "ai-agent",
    "tui",
    "ink",
    "postgres",
    "nio"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && node --input-type=commonjs -e \"const fs=require('fs');fs.cpSync('src/cli/copy','dist/cli/copy',{recursive:true});for(const f of ['cli.js','mcp-server.js','gateway/index.js','mcp-server-lang.js'])fs.chmodSync('dist/'+f,0o755)\"",
    "gen:docs": "bun run scripts/gen-reference.ts",
    "db:ping": "bun run scripts/db-ping.ts",
    "dev:sms-echo": "bun run scripts/sms-echo.ts",
    "dev:cli": "bun run src/cli.ts",
    "dev:mcp": "bun run src/mcp-server.ts",
    "dev:gateway": "bun run src/gateway/index.ts",
    "dev:lang": "bun run src/mcp-server-lang.ts",
    "dev:docker": "docker compose -f docker/docker-compose.yml up --build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@node-rs/argon2": "^2.1.0",
    "@opencode-ai/sdk": "1.18.25",
    "adm-zip": "^0.5.17",
    "boxen": "^7.1.1",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "ink": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "smol-toml": "^1.6.1",
    "update-notifier": "^7.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3",
    "@types/update-notifier": "^6.0.8",
    "ink-testing-library": "^4",
    "typescript": "^5.4.5"
  }
}
