# NIO-CLI Test Environment
# Copy to .env.test and fill in generated values

# Database (test instance)
NIO_DATABASE_URL=postgres://nio_cli_user:test@localhost:5432/nio_cli_test
NIO_GATEWAY_DATABASE_URL=postgres://nio_gw_user:test@localhost:5432/nio_cli_test

# Database SSL (force TLS for test, like prod)
NIO_DATABASE_SSL=true
NIO_DATABASE_CA=/Users/hugo/Desktop/NIO-CLI/NIO-CLI-/docker/fixtures/db-ca.pem
# NIO_DATABASE_SSL_SERVERNAME=postgres-test
# NIO_DATABASE_SSL_INSECURE=1   # only if CA doesn't work

# Secrets (generate with scripts listed in comments)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# openssl rand -base64 32 (copy only the result, no newlines)
# Format: id:secret (where id is numeric)
NIO_PEPPERS=

# Optional: separate HMAC key for OTP, default=JWT_SECRET
# OTP_HMAC_SECRET=

# Gateway binding
NIO_GATEWAY_HOST=127.0.0.1
# NIO_GATEWAY_URL=http://127.0.0.1:3000  # default when gateway is direct

# Kong proxy (if running)
# NIO_KONG_PROXY_PORT=8000
# NIO_TRUST_PROXY=0  # set to 1 only if Kong is sole entrypoint

# WhatsApp 2FA (test mode = echo, no real SMS)
WHATSAPP_ENDPOINT_URL=http://127.0.0.1:3001/send
WHATSAPP_TOKEN=test-token
# WHATSAPP_TEMPLATE_NAME=autenticacao
# WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# IA Client (optional, defaults to OpenCode Zen)
# NIO_AI_BASE_URL=http://127.0.0.1:8001/v1
# NIO_AI_MODEL=Qwen3.8-27B-INT4
# NIO_HEADROOM_URL=http://127.0.0.1:8787/v1

# Logging
# NIO_DEBUG=1
# NIO_NO_ANIM=1

# Test config
NODE_ENV=test
