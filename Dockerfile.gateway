# Build reprodutível (auditoria M-2 + I-3a): um lockfile só (`bun.lock`), imagens
# pinadas por digest. Multi-stage — o Bun resolve as deps com o lockfile
# congelado; o runtime continua sendo Node (o alvo do projeto).

# --- deps: instala node_modules de runtime a partir do bun.lock ---
FROM oven/bun:1-slim@sha256:cb3bbbb08e13a4a2ff400f24c7a2a1d5efa83f6ef8544d52d95a519631e2fc61 AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

# --- runtime: Node + curl (healthcheck do compose) ---
FROM node:25-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY dist ./dist
# N-6: sem root — a imagem `node` já traz o usuário `node` (uid 1000); :3000 não é privilegiada.
USER node
EXPOSE 3000
CMD ["node", "dist/gateway/index.js"]
