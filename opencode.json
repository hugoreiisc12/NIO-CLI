{
    "$schema":  "https://opencode.ai/config.json",
    "shell":  "powershell",
    "instructions":  [
                         "CLAUDE.md"
                     ],
    "snapshot":  true,
    "autoupdate":  "notify",
    "share":  "manual",
    "logLevel":  "INFO",
    "formatter":  true,
    "lsp":  true,
    "compaction":  {
                       "auto":  true,
                       "tail_turns":  15
                   },
    "skills":  {
                   "paths":  [
                                 ".opencode/skills"
                             ]
               },
    "mcp":  {
                "nio":  {
                            "type":  "local",
                            "command":  [
                                            "nio-cli"
                                        ],
                            "enabled":  true,
                            "environment":  {
                                                "NIO_CLIENT":  "opencode"
                                            }
                        }
            },
    "permission":  {
                       "read":  "allow",
                       "edit":  "ask",
                       "bash":  {
                                    "bun *":  "allow",
                                    "bunx *":  "allow",
                                    "git *":  "allow",
                                    "ls *":  "allow",
                                    "dir *":  "allow",
                                    "cat *":  "allow",
                                    "type *":  "allow",
                                    "*":  "ask"
                                },
                       "glob":  "allow",
                       "grep":  "allow",
                       "list":  "allow",
                       "webfetch":  "allow",
                       "websearch":  "allow",
                       "todowrite":  "allow",
                       "question":  "allow"
                   },
    "watcher":  {
                    "ignore":  [
                                   "node_modules/**",
                                   "dist/**",
                                   "*.log",
                                   ".env",
                                   ".env.local"
                               ]
                },
    "model":  "opencode/big-pickle"
}
