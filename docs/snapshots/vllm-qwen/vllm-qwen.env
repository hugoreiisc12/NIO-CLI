# Snapshot 2026-10-10 — config do motor de IA ANTES de trocar para Ollama (Nemotron mini).
# Todos os valores abaixo são os efetivos do vLLM/Qwen (defaults do código + ~/.nio/config.env).
# Restaurar: copie estas linhas para ~/.nio/config.env (e comente as do Ollama).

# ── Provider / modelo ────────────────────────────────────────────────────
NIO_AI_PROVIDER=nio-local
NIO_AI_BASE_URL=http://192.168.0.140:8001/v1
NIO_AI_MODEL=RedHatAI/Qwen3.8-27B-INT4
# Ref gravado no opencode.json: nio-local/RedHatAI/Qwen3.8-27B-INT4

# ── Janela / limites ─────────────────────────────────────────────────────
NIO_AI_CONTEXT=65536          # declarado ao opencode: 50790 (65536 - 8192 saída - 10% margem)
NIO_AI_OUTPUT=8192            # reasoning consome este teto; 2048 deu content vazio (medido 2026-10-02)
NIO_AI_MAX_INPUT=32000        # fail-fast do headless (nio exec/plan/validate-plan)
NIO_AI_MAPREDUCE_THRESHOLD=32000
NIO_AI_THINK=false            # headless manda chat_template_kwargs {enable_thinking:false}

# ── Capacidades ──────────────────────────────────────────────────────────
NIO_AI_VISION=true            # attachment:true + modalities input [text,image]
NIO_AI_MAX_IMAGE_BYTES=1500000
NIO_AI_IMAGE_MAX_DIM=1024
NIO_AI_WARMUP=true            # aquece o prefixo (prefill ~21k tokens) numa sessão descartável

# ── Saída de tools ───────────────────────────────────────────────────────
NIO_AI_TOOL_OUTPUT_BYTES=20000
NIO_AI_TOOL_OUTPUT_LINES=800

# ── Embeddings (local, ONNX/CPU — NÃO depende do vLLM) ───────────────────
NIO_AI_EMBED_MODEL=Xenova/multilingual-e5-base

# ── Aprendizado e RAG de DAX (limiares calibrados com o Qwen) ────────────
NIO_LEARN=true
NIO_LEARN_MIN_SCORE=0.82
NIO_LEARN_TOPK=3
NIO_FABRIC_RAG_TEMPLATE_MIN=0.88
NIO_FABRIC_RAG_TOPK=5
NIO_FABRIC_RAG_MIN_SCORE=0.6
NIO_FABRIC_RAG_MAX_CHUNK_CHARS=1200
NIO_FABRIC_RAG_MAX_TOTAL_CHARS=6000
NIO_FABRIC_MAX_ROWS=100
NIO_FABRIC_MAX_ROW_CHARS=20000
